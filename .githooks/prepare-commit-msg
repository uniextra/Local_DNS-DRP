#!/usr/bin/env bash
set -euo pipefail

msg_file=${1:?commit message file is required}
commit_source=${2-}

[[ "${SKIP_AI_COAUTHORS:-0}" == "1" ]] && exit 0
[[ "$commit_source" == "merge" ]] && exit 0

mapfile -t coauthors < <(git config --get-all ai.coauthor || true)
[[ ${#coauthors[@]} -eq 0 ]] && exit 0

append_trailer() {
    local entry=$1
    local trailer="Co-authored-by: $entry"

    if grep -Fiq "$trailer" "$msg_file"; then
        return
    fi

    local tmp_file="${msg_file}.tmp.$$"

    awk -v trailer="$trailer" '
        { lines[NR]=$0; if (NF) last=NR }
        END {
            for (i=1; i<=last; i++) print lines[i]
            if (last > 0 && lines[last] !~ /^Co-authored-by:[[:space:]]*/) print ""
            print trailer
        }
    ' "$msg_file" > "$tmp_file"

    mv "$tmp_file" "$msg_file"
}

for coauthor in "${coauthors[@]}"; do
    append_trailer "$coauthor"
done
