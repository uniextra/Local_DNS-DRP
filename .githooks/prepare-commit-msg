#!/usr/bin/env bash
set -euo pipefail

msg_file=${1:?commit message file is required}
commit_source=${2-}

# Never modify merge commits or explicitly skipped commits.
[[ "${SKIP_AI_COAUTHORS:-0}" == "1" ]] && exit 0
[[ "$commit_source" == "merge" ]] && exit 0

coauthor="codex <codex@openai.com>"
trailer="Co-authored-by: $coauthor"

# Avoid duplicates, including case-only differences.
if grep -Fiq "$trailer" "$msg_file"; then
  exit 0
fi

python3 - "$msg_file" "$trailer" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
trailer = sys.argv[2]
text = path.read_text()
body = text.rstrip("\n")
if body:
    body += "\n\n"
path.write_text(body + trailer + "\n")
PY
