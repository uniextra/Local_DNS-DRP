# DNS targets: comma-separated name=IP[:port] values.
# IPv4 example:
TARGETS=home=192.168.1.2,backup=192.168.1.3
# IPv6 example (brackets required when specifying a non-default port):
# TARGETS=home=[2001:db8::10]:53

# Telegram bot credentials
TELEGRAM_BOT_TOKEN=123456789:replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_chat_id

# Monitoring
CHECK_INTERVAL=60
DNS_TIMEOUT=3
DNS_TEST_DOMAIN=example.com
TELEGRAM_TIMEOUT=10
LOG_LEVEL=INFO
